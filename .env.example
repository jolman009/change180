VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=your_newsletter_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Stripe billing backend (required for API routes)
STRIPE_SECRET_KEY=sk_test_or_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
SITE_BASE_URL=https://change180.org
STRIPE_PORTAL_RETURN_URL=https://change180.org

# Calendly webhook (required)
CALENDLY_WEBHOOK_SIGNING_KEY=your_calendly_signing_key

# OPTIONAL: explicit Calendly event type -> package mapping.
# If omitted, packages are matched by keyword in event type name
# (e.g., "Discovery Session" -> discovery, "Family Coaching" -> family).
# CALENDLY_EVENT_TYPE_MAP_JSON={"https://api.calendly.com/event_types/UUID":"discovery",...}

# Transactional email via Resend (required)
RESEND_API_KEY=re_xxx
BILLING_FROM_EMAIL=admin@change180.org
BILLING_SUPPORT_EMAIL=change180life@gmail.com

# Stripe price IDs (optional — code falls back to inline prices if omitted)
# STRIPE_PRICE_ID_DISCOVERY=price_xxx
# STRIPE_PRICE_ID_FAMILY=price_xxx
# STRIPE_PRICE_ID_CLARITY=price_xxx
# STRIPE_PRICE_ID_ROOTED=price_xxx
# STRIPE_PRICE_ID_FLOURISH=price_xxx

# Database (required — Vercel Postgres integration auto-injects this)
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require
